{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Highland: Attach to make debug",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "justMyCode": true,
      "subProcess": true
    },
    {
      "name": "Highland: Debug meeting-preparation test",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q",
        "-s",
        "tests/acceptance/test_meeting_preparation.py"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "env": {
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/src",
        "HIGHLAND_MODEL_BACKEND": "scripted"
      }
    }
  ]
}
