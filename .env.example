# Highland defaults to a deterministic provider. Set cohere explicitly for live calls.
HIGHLAND_MODEL_BACKEND=scripted
COHERE_API_KEY=

HIGHLAND_WORKSPACE_DIR=var/highland
HIGHLAND_MOCK_CATALOG_URL=http://127.0.0.1:8099
HIGHLAND_SEED_DIR=./data/seed
HIGHLAND_RUNTIME_DIR=./var
HIGHLAND_CRM_URL=http://localhost:8101
HIGHLAND_KNOWLEDGE_URL=http://localhost:8102
HIGHLAND_SUPPORT_URL=http://localhost:8103
HIGHLAND_OBSERVABILITY_URL=http://localhost:8104
HIGHLAND_COMMUNICATIONS_URL=http://localhost:8105
HIGHLAND_PROJECTS_URL=http://localhost:8106
HIGHLAND_CHAT_MODEL=command-a-plus-05-2026
HIGHLAND_EMBEDDING_MODEL=embed-v4.0
HIGHLAND_RERANK_MODEL=rerank-v4.0-fast

HIGHLAND_REQUEST_TIMEOUT_SECONDS=30
HIGHLAND_CONNECTOR_TIMEOUT_SECONDS=15
HIGHLAND_MAX_STEPS_PER_RUN=20
HIGHLAND_MAX_MODEL_CALLS_PER_RUN=10
HIGHLAND_MAX_RERANK_SEARCHES_PER_RUN=10
HIGHLAND_MAX_TOKENS_PER_RUN=100000
HIGHLAND_MAX_RUN_COST_USD=0.10
HIGHLAND_MONTHLY_BUDGET_USD=5.00
