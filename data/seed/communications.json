      "channel": "support-northwind",
      "thread_id": "thr_latency_northwind",
      "author": {
        "id": "usr_jonah",
        "name": "Jonah Okafor"
      },
      "created_at": "2026-07-28T14:22:00Z",
      "text": "This resembles the 4.18.2 first-compaction limitation, but we should call it a hypothesis until tonight's controlled run. Please avoid telling Northwind that the upgrade is definitively the root cause.",
      "visibility": "support",
      "updated_at": "2026-07-28T14:22:00Z",
      "source_url": "https://pulse.summit.test/channels/support-northwind/msg_7002"
    },
    {
      "source_system": "pulse",
